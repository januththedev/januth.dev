# Real Linux terminal (/api/shell)
# 24+ random characters — signs visitors' session tokens.  openssl rand -hex 32
SHELL_SECRET=

# Vercel Sandbox auth. On Vercel this is automatic (OIDC). Locally, run
# `vercel link && vercel env pull` to get VERCEL_OIDC_TOKEN, or set:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
