# ---------------------------------------------------------------------------
# Real Linux terminal (/api/shell)
# REQUIRED for the real shell. Any 32+ random characters; signs visitors'
# session tokens. Generate one with:  openssl rand -hex 32
# Without it the terminal falls back to the built-in virtual shell.
SHELL_SECRET=

# Vercel Sandbox auth — nothing to set on Vercel: deployments authenticate
# automatically with OIDC (VERCEL_OIDC_TOKEN is injected for you).
# Locally, run `vercel link` then `vercel env pull .env.local`, or set:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# GitHub (build time only, optional but recommended on Vercel)
# A fine-grained token with no extra permissions (public repos only) raises
# the build's GitHub API limit from 60 to 5000 requests/hour, so the project
# cards never fall back to stale numbers. Never exposed to the browser.
GITHUB_TOKEN=

# Vercel Web Analytics needs no env vars — enable it in the project's
# Analytics tab and it starts counting after the next deploy.
