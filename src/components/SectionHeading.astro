---
interface Props {
  kicker: string;
  title: string;
  sub?: string;
  /** the page's main heading should be an h1; sections below it h2 */
  as?: 'h1' | 'h2';
}
const { kicker, title, sub, as = 'h2' } = Astro.props as Props;
const Tag = as;
---

<div class="section-heading" data-reveal>
  <span class="kicker">{kicker}</span>
  <Tag class="section-title" data-split set:html={title} />
  {sub && <p class="section-sub">{sub}</p>}
</div>
