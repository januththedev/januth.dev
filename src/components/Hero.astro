---
import { site } from '../config/site';

/** lowercase fragments revealed with the typed fill-wipe, house-style */
const frags = ['a builder.', 'a creative coder.', 'a professional tinkerer.'];

const stats = [
  { num: '100%', label: 'hand-built, zero templates', countFrom: 0 },
  { num: '0', label: 'boring sites made', countFrom: 47 },
  { num: '24/7', label: 'build mode', countFrom: null },
  { num: '∞', label: 'curiosity (unbounded)', countFrom: null },
];
---

<div id="space">
  <div class="stage" id="stage">
    <div class="jn-ascii" id="jn-ascii" aria-hidden="true"></div>

    <div class="big-title" aria-hidden="true">{site.monogram}</div>

    <section class="panel" id="intro">
      <div class="intro-box">
        <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">
          {site.name} — portfolio
        </h1>
        {frags.map((f) => <span class="frag type">{f}</span>)}
        <p class="create-line">
          i love creating
          <span class="create-rotator" id="create-rotator">
            <span>cool things.</span>
            <span>useful tools.</span>
            <span>browser chaos.</span>
            <span>this site.</span>
          </span>
        </p>
      </div>
    </section>

    <section class="panel" id="data">
      {stats.map((s) => (
        <div class="data-container">
          <div
            class="data-number"
            data-count-to={s.num}
            data-count-from={s.countFrom ?? ''}
          >
            {s.num}
          </div>
          <div class="data-title">{s.label}</div>
        </div>
      ))}
    </section>

    <div id="alot" aria-hidden="true">that's a lot.</div>

    <section class="panel" id="avatar">
      <span class="ascii-caption">that's me — spinning, rendered in nothing but characters</span>
    </section>

    <div class="scroll-cue mono" aria-hidden="true">scroll ↓</div>
  </div>
</div>

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="pre-inner">
    <span class="pre-logo display">{site.monogram}</span>
    <span class="mono" id="pre-count">0%</span>
  </div>
</div>

<script>
  // count-up when the data beat scrolls into view; counts DOWN on purpose for the joke stat
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function animate(el: HTMLElement) {
    const to = el.dataset.countTo ?? '';
    const fromRaw = el.dataset.countFrom ?? '';
    if (!fromRaw || !/\d/.test(to)) return;
    const toNum = parseInt(to.replace(/\D/g, ''), 10);
    const fromNum = parseInt(fromRaw, 10);
    const prefix = /^\D+/.exec(to)?.[0] ?? '';
    const suffix = /\D+$/.exec(to)?.[0] ?? '';
    const dur = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      if (!document.body.contains(el)) return;
      const p = Math.min(1, (now - start) / dur);
      el.textContent = `${prefix}${Math.round(fromNum + (toNum - fromNum) * ease(p))}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  document.addEventListener('astro:page-load', () => {
    const data = document.getElementById('data');
    if (!data) return;
    const nums = [...data.querySelectorAll<HTMLElement>('.data-number[data-count-from]:not([data-count-from=""])')];
    if (!nums.length) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      nums.forEach((n) => (n.textContent = n.dataset.countTo ?? n.textContent));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          nums.forEach(animate);
          io.disconnect();
        }
      },
      { threshold: 0.4 }
    );
    io.observe(data);
  });
</script>
