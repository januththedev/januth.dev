---
import { site } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => ((href.replace(/\/$/, '') || '/') === path ? 'page' : undefined);
---

<header class="site-header" id="site-header">
  <div class="container header-row">
    <a href="/" class="logo" id="logo-btn" aria-label={`${site.name} — home`}>{site.monogram}</a>
    <nav class="site-nav" aria-label="Main">
      <a href="/projects/" aria-current={current('/projects')} data-scramble>projects</a>
      <a href="/about/" aria-current={current('/about')} data-scramble>about</a>
      <a href="#contact" data-scramble>contact</a>
    </nav>
    <button type="button" class="term-open-btn" data-term-open aria-label="Open terminal" aria-keyshortcuts="`">
      <span class="label">~ terminal</span><span class="key" aria-hidden="true">`</span>
    </button>
  </div>
</header>
