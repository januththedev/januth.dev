---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../config/site';
---

<Base>
  <Hero />

  <section class="section container" id="work">
    <SectionHeading
      kicker="01 — selected work"
      title={`things i've <span style="color:var(--accent)">made</span>`}
      sub="a taste of what keeps me up at night. the full, always-current list lives on the projects page — pulled straight from GitHub."
    />
    <div class="teaser-grid">
      {site.curated.map((c, i) => (
        <a class="teaser" href={c.href} style={`--i:${i + 1}`} data-reveal data-cursor>
          <span class="t-kicker mono">{c.kicker}</span>
          <h3>{c.title}</h3>
          <p>{c.blurb}</p>
          <span class="t-cta">{c.cta}</span>
        </a>
      ))}
    </div>
    <a class="more-link mono" href="/projects/">every repo i've pushed → live from github</a>
  </section>
</Base>
